# AccessMap Frontend Environment Variables Template
# Copy this file to .env or .env.local to configure your local setup

# Base URL pointing to the Spring Boot REST API
VITE_API_BASE_URL=http://localhost:8080

# MapLibre Map Style URL (e.g. MapLibre demo tiles, Stadia Maps, MapTiler, Protomaps, etc.)
# If left empty, defaults to MapLibre's open vector demo tiles (https://demotiles.maplibre.org/style.json)
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot Parent — provides default dependency versions and plugin config -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <!-- Project Coordinates -->
  <groupId>com.accessmap</groupId>
  <artifactId>accessmap-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>accessmap-backend</name>
  <description>AccessMap: Intelligent Physical Accessibility Discovery and Verification Platform — Backend API</description>

  <!-- Java Version — set to 21 (compiled bytecode target); JDK 26 is used to build -->
  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <lombok.version>1.18.38</lombok.version>
  </properties>

  <dependencies>

    <!-- ================================================================ -->
    <!-- CORE SPRING BOOT                                                  -->
    <!-- ================================================================ -->

    <!-- Spring Web: REST controllers, embedded Tomcat, Jackson JSON -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Spring Data JPA: Repository abstraction over Hibernate ORM -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Spring Security: Authentication, authorization, and CORS filter chain -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Bean Validation: @Valid, @NotNull, @Size, @DecimalMin on DTOs -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Spring Boot Actuator: /actuator/health health check endpoint -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ================================================================ -->
    <!-- DATABASE                                                          -->
    <!-- ================================================================ -->

    <!-- PostgreSQL JDBC Driver: Runtime driver for PostgreSQL 16 connections -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Hibernate Spatial: PostGIS geometry type mapping (Point, Polygon, etc.) -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-spatial</artifactId>
    </dependency>

    <!-- Flyway: Versioned SQL migration execution on startup -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <!-- Flyway PostgreSQL: Flyway dialect support for PostgreSQL -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- ================================================================ -->
    <!-- SECURITY / JWT                                                    -->
    <!-- ================================================================ -->

    <!-- JWT API: Standard JWT creation and parsing contracts -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.6</version>
    </dependency>

    <!-- JWT Impl: JJWT signing and validation implementation -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>

    <!-- JWT Jackson: Jackson-based JSON serialization for JWT claims -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>

    <!-- ================================================================ -->
    <!-- UTILITIES                                                         -->
    <!-- ================================================================ -->

    <!-- Lombok: Compile-time @Getter, @Setter, @Builder, @Data code generation
         Pinned to 1.18.38 for JDK 24+ compatibility (fixes TypeTag.UNKNOWN crash) -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- ================================================================ -->
    <!-- TESTING                                                           -->
    <!-- ================================================================ -->

    <!-- Spring Boot Test: JUnit 5, MockMvc, AssertJ, Mockito -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Spring Security Test: @WithMockUser, SecurityMockMvcRequestPostProcessors -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- H2 In-Memory DB: Lightweight database for unit and integration tests / local dev -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ================================================================ -->
    <!-- OBJECT STORAGE                                                    -->
    <!-- ================================================================ -->

    <!-- MinIO Java SDK: S3-compatible object storage client for profile
         photo and report-evidence uploads. Communicates with MinIO locally
         and can point to any S3-compatible service (AWS, GCS, R2) in prod. -->
    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
      <version>8.5.12</version>
    </dependency>

    <!-- OkHttp: Required by MinIO SDK at runtime -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>4.12.0</version>
    </dependency>

    <!-- ================================================================ -->
    <!-- IMAGE PROCESSING / SECURITY                                       -->
    <!-- ================================================================ -->

    <!-- Apache Tika Core: Content-type detection from raw bytes, not
         file extension or browser-declared MIME type. Prevents disguised
         non-image uploads. Using core only (no parsers) to stay lightweight. -->
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-core</artifactId>
      <version>2.9.2</version>
    </dependency>

    <!-- Thumbnailator: Pure-Java image re-encoding, resizing, and EXIF
         stripping. Removes embedded GPS coordinates and other metadata
         from uploaded photographs before they are stored. -->
    <dependency>
      <groupId>net.coobird</groupId>
      <artifactId>thumbnailator</artifactId>
      <version>0.4.20</version>
    </dependency>

    <!-- Spring Multipart: Already available through spring-boot-starter-web,
         listed here for documentation clarity. No additional artifact needed. -->

  </dependencies>

  <build>
    <plugins>

      <!-- Maven Compiler Plugin: explicitly wire Lombok as an annotation processor
           so that it works correctly on Java 21+ / JDK 26 environments. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- Maven Surefire Plugin: run tests with bytebuddy.experimental for JDK 26 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Dnet.bytebuddy.experimental=true</argLine>
        </configuration>
      </plugin>

      <!-- Spring Boot Maven Plugin: Creates executable fat JAR -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Exclude Lombok from the final executable JAR (annotation-only, not needed at runtime) -->
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

    </plugins>
  </build>

</project>


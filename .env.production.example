# =============================================================================
# AccessMap — Production Environment Configuration Template
# =============================================================================
# Copy this template to configure production environments on Render & Vercel.
# IMPORTANT: Never commit files containing actual secrets to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Spring Boot Backend (Configure as Environment Variables in Render)
# -----------------------------------------------------------------------------

# Active Spring Profile (must be 'prod')
SPRING_PROFILES_ACTIVE=prod

# Container Port (Render automatically sets $PORT, default: 8080)
PORT=8080

# Production JWT Secret Key (REQUIRED: minimum 256 bits / 32 bytes random string)
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_in_production

# JWT Expiration in milliseconds (Default: 3600000 = 1 hour)
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated list of production frontend origins)
CORS_ORIGINS=https://accessmap.vercel.app,https://your-custom-domain.com

# -----------------------------------------------------------------------------
# 2. Database — Supabase PostgreSQL 16 + PostGIS
# -----------------------------------------------------------------------------

# Supabase Connection URL (Transaction Pooler or Direct Connection with SSL)
# Example: jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&options=-csearch_path%3Dpublic,extensions
DB_URL=jdbc:postgresql://db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres?sslmode=require&options=-csearch_path%3Dpublic,extensions

# Database Credentials
DB_USER=postgres
DB_PASSWORD=replace_with_your_supabase_db_password

# Connection Pool Settings (HikariCP)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# -----------------------------------------------------------------------------
# 3. Object Storage — Cloudflare R2 (S3-Compatible API)
# -----------------------------------------------------------------------------

STORAGE_PROVIDER=s3
# Cloudflare R2 S3 API Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=replace_with_cloudflare_r2_access_key_id
STORAGE_SECRET_KEY=replace_with_cloudflare_r2_secret_access_key
STORAGE_BUCKET=accessmap-media
STORAGE_REGION=auto

# Optional: Cloudflare R2 Public Bucket Domain or Custom Domain (CDN accelerated)
# Example: https://media.your-domain.com or https://pub-xxxxxx.r2.dev
STORAGE_PUBLIC_URL_PREFIX=https://media.accessmap.org

# Pre-signed URL expiry in minutes (Default: 60)
STORAGE_PRESIGNED_URL_EXPIRY_MINUTES=60

# -----------------------------------------------------------------------------
# 4. OpenStreetMap / Overpass Integration
# -----------------------------------------------------------------------------
OSM_ENABLED=true
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OSM_TIMEOUT_SECONDS=15
OSM_RATE_LIMIT_MS=1000

# -----------------------------------------------------------------------------
# 5. AI Assistant & Provider (Phase 14)
# -----------------------------------------------------------------------------
AI_ENABLED=true
# Set to 'openai-compatible' to use OpenAI or local LLM gateway; or 'mock'
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_or_groq_api_key_here
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# 6. Frontend — React / Vite (Configure in Vercel Project Settings)
# -----------------------------------------------------------------------------

# Public Base URL pointing to the deployed Render backend
VITE_API_BASE_URL=https://accessmap-backend.onrender.com

# Vector Map Style URL
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json


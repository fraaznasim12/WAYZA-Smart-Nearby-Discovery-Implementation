# AccessMap Environment Variables Template
# Copy this file to .env and adjust for local environment

DB_HOST=localhost
DB_PORT=5432
DB_NAME=accessmap
DB_USER=accessmap_user
DB_PASSWORD=accessmap_dev_password

# JWT Configuration (Minimum 256 bits for HMAC-SHA256)
JWT_SECRET=ThisIsAPlaceholderSecretChangeItInProductionNow!!
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Port
PORT=8080

